# Copy to .env and fill in. NEVER commit a real key.

# Required for all Gemini features (embeddings + Google Search/Maps grounding).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults documented in README).
# Embedding model: must support 768-dim output. Default: gemini-embedding-2
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Text model used for Google Search / Maps grounding. Default: gemini-2.5-flash
# (supports BOTH google_search and google_maps tools; switch to a newer Flash model if available on your account)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Session secret (falls back to a dev default if unset)
SESSION_SECRET=
